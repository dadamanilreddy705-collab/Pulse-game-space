name: Convert HTML to APK

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: Set up Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '20'

    - name: Build Web App with Cordova
      run: |
        npm install -g cordova
        cordova create myApp com.example.myapp MyAndroidApp
        cd myApp
        cordova platform add android
        # Copy your HTML files into www folder
        rm -rf www/*
        cp -r ../* www/ 2>/dev/null || true
        # Clean up config files from copying into www
        rm -rf www/myApp www/.git www/.github
        cordova build android --debug

    - name: Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: app-debug-apk
        path: myApp/platforms/android/app/build/outputs/apk/debug/app-debug.apk

    
